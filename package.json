{
    "name": "@laird-wt/portal",
    "private": false,
    "version": "1.7.0",
    "type": "module",
    "description": "Publishable React game-input and virtual-controller component library.",
    "license": "MIT",
    "author": "laird-wt",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/LairdWT/portal.git"
    },
    "publishConfig": {
        "access": "public"
    },
    "sideEffects": [
        "**/*.css"
    ],
    "files": [
        "dist"
    ],
    "main": "./dist/portal.js",
    "module": "./dist/portal.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/portal.js"
        },
        "./styles.css": "./dist/portal.css",
        "./theme": {
            "types": "./dist/theme.d.ts",
            "import": "./dist/theme.js"
        },
        "./r3f": {
            "types": "./dist/r3f.d.ts",
            "import": "./dist/r3f.js"
        },
        "./shaders": {
            "types": "./dist/shaders.d.ts",
            "import": "./dist/shaders.js"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "dev": "storybook dev -p 6006",
        "build": "vite build",
        "prepack": "pnpm build",
        "typecheck": "tsc -b --pretty",
        "typecheck:scripts": "tsc -p tsconfig.scripts.json",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "lint:css": "stylelint \"src/**/*.css\"",
        "lint:css:fix": "stylelint \"src/**/*.css\" --fix",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "test": "vitest",
        "test:run": "vitest run --project unit",
        "test:stories": "vitest run --project storybook",
        "test:coverage": "vitest run --coverage",
        "e2e": "playwright test",
        "e2e:behavior": "playwright test --project=behavior",
        "smoke:pack": "node scripts/packaging-smoke.mjs",
        "example:typecheck": "pnpm -C example exec tsc --noEmit",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "verify": "pnpm typecheck && pnpm typecheck:scripts && pnpm lint && pnpm lint:css && pnpm format:check && pnpm test:run && pnpm test:stories && pnpm build"
    },
    "peerDependencies": {
        "@react-three/drei": ">=9",
        "@react-three/fiber": ">=8",
        "animejs": ">=4",
        "react": ">=18",
        "react-dom": ">=18",
        "three": ">=0.160"
    },
    "peerDependenciesMeta": {
        "@react-three/drei": {
            "optional": true
        },
        "@react-three/fiber": {
            "optional": true
        },
        "three": {
            "optional": true
        }
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "1.61.0",
        "@react-three/drei": "10.7.7",
        "@react-three/fiber": "9.6.1",
        "@storybook/addon-a11y": "^10.4.6",
        "@storybook/addon-docs": "^10.4.6",
        "@storybook/addon-vitest": "^10.4.6",
        "@storybook/react-vite": "^10.4.6",
        "@testing-library/jest-dom": "6.9.1",
        "@testing-library/react": "16.3.2",
        "@testing-library/user-event": "14.6.1",
        "@types/node": "^24.13.2",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@types/three": "0.184.1",
        "@vitejs/plugin-react": "^6.0.1",
        "@vitest/browser-playwright": "4.1.9",
        "@vitest/coverage-v8": "4.1.9",
        "animejs": "4.4.1",
        "eslint": "^10.3.0",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-jsx-a11y": "6.10.2",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-simple-import-sort": "13.0.0",
        "globals": "^17.6.0",
        "jsdom": "29.1.1",
        "prettier": "3.8.4",
        "r3f-perf": "7.2.3",
        "react": "^19.2.6",
        "react-dom": "^19.2.6",
        "storybook": "^10.4.6",
        "stylelint": "17.13.0",
        "stylelint-config-css-modules": "4.6.0",
        "stylelint-config-standard": "40.0.0",
        "three": "0.184.0",
        "typescript": "~6.0.2",
        "typescript-eslint": "^8.59.2",
        "vite": "^8.0.12",
        "vite-plugin-dts": "^4.5.4",
        "vitest": "4.1.9"
    },
    "packageManager": "pnpm@11.8.0+sha512.c1f5e7c4cb241c8f174b743851d82f42b802324afc8b0f116b96adb15aa06664948dde36960a3ba1079ba5b4b29dd0140135b94b5b5f5263592249d68e555f26"
}
