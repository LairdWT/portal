{
    "compilerOptions": {
        "target": "ESNext",
        "lib": ["ESNext", "DOM", "DOM.Iterable"],
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "types": ["node"],
        "allowJs": true,
        "checkJs": true,
        "noEmit": true,
        "skipLibCheck": true,
        "strict": true
    },
    "include": ["scripts/**/*.mjs"]
}
